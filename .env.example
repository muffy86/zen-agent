# zen-agent credentials. Copy to .env (gitignored) or export these in your shell.
# Real environment variables always win over this file.
#
# Zen: https://opencode.ai/auth -> sign in -> Console -> Create API Key
# NOTE: the Zen *free* lane only works inside the OpenCode client. For a third-party client such as
# zen-agent you need OpenCode Go (https://opencode.ai/go) or Console credits.
# OPENCODE_ZEN_API_KEY=
#
# Publishing the npm package to GitHub Packages (Classic token, scope write:packages):
# https://github.com/settings/tokens/new?scopes=write:packages,read:packages
# NODE_AUTH_TOKEN=
# GITHUB_TOKEN=
#
# Optional paid providers (catalog entries until a key exists) — see docs/KEY-PAGES.md
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
